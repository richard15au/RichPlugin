{
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true
  },
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/deepseek_agent.sh:*)",
      "Bash(python3 .claude/scripts/deepseek_worker.py:*)",
      "Bash(rtk:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./yarn.lock)",
      "Read(./vault/.obsidian/**)",
      "Read(./.claude/logs/**)",
      "Read(./.worktrees/**)"
    ]
  }
}

{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SLACK_WEBHOOK_URL\" ] && curl -s -X POST -H 'Content-type: application/json' --data \"{\\\"text\\\":\\\"✅ Agent finished a turn in $(basename \\\"$CLAUDE_PROJECT_DIR\\\")\\\"}\" \"$SLACK_WEBHOOK_URL\" >/dev/null || true"
          }
        ]
      }
    ]
  }
}
