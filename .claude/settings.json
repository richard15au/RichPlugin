{
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "richard-stack": {
      "source": {
        "source": "github",
        "repo": "richard15au/Claude-test"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "agent-stack@richard-stack": false
  },
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/deepseek_agent.sh:*)",
      "Bash(python3 .claude/scripts/deepseek_worker.py:*)",
      "Bash(rtk:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./yarn.lock)",
      "Read(./vault/.obsidian/**)",
      "Read(./.claude/logs/**)",
      "Read(./.worktrees/**)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/agent-stack/scripts/notify.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/agent-stack/scripts/notify.sh\""
          }
        ]
      }
    ]
  }
}
