# Copy to .env (which git ignores) and fill in. Never commit .env.
DEEPSEEK_API_KEY=
# Optional
DEEPSEEK_MODEL=deepseek-flash
# Optional Slack alerts (an incoming-webhook URL; stays out of the workers' environment)
SLACK_WEBHOOK_URL=
# Set to 1 to also get a message every time Claude finishes a turn
SLACK_NOTIFY_ON_STOP=
